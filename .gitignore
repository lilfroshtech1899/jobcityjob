# Dependencies
node_modules/

# Environment files (real secrets — never commit)
.env
.env.local
.env.production

# PHP API local secrets — never commit (keep only config.example.php)
api/config.php
api/_smoke*.ps1

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db

# Supabase CLI temp / generated files
supabase/.temp/

# Vercel build output — generated locally by scripts/build.js
public/

# NOTE: js/config/runtime-config.js is intentionally committed as a placeholder template.
# The build script (scripts/generate-runtime-config.js) overwrites it with real
# values from environment variables at deploy time, so do NOT ignore it here.
