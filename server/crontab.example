# Jobcityjob FX – place in crontab -e (server timezone)
# Refresh exchange rates every 12 hours
0 */12 * * * cd /var/www/jobcityjob/server && /usr/bin/node exchange-rates-cron.js >> /var/log/jobcityjob-fx.log 2>&1

# Optional: daily at 06:00 only
# 0 6 * * * cd /var/www/jobcityjob/server && /usr/bin/node exchange-rates-cron.js >> /var/log/jobcityjob-fx.log 2>&1
